# Copy to .env and adjust. docker compose reads this file automatically.

# --- Postgres (used by the db service) ---
POSTGRES_USER=clinicalcompass
POSTGRES_PASSWORD=clinicalcompass
POSTGRES_DB=clinicalcompass

# --- API ---
# Inside compose the DB host is the service name "db".
DATABASE_URL=postgresql+psycopg://clinicalcompass:clinicalcompass@db:5432/clinicalcompass

# Port nginx is published on (http://localhost:${NGINX_PORT})
NGINX_PORT=8080

# --- PE Compass backend (independent DB + API, served at /pe/) ---
PE_POSTGRES_USER=pe
PE_POSTGRES_PASSWORD=pe
PE_POSTGRES_DB=pe
# Inside compose the PE DB host is the service name "pe-db".
PE_DATABASE_URL=postgresql+psycopg://pe:pe@pe-db:5432/pe
# Auth: JWT signing key + token lifetimes. CHANGE PE_JWT_SECRET in production.
PE_JWT_SECRET=dev-only-change-me
PE_ACCESS_TOKEN_TTL_MINUTES=30
PE_REFRESH_TOKEN_TTL_DAYS=30
# Public app URL used to build password-reset links (<url>/reset-password?token=).
PE_APP_BASE_URL=http://localhost:8080
# Email / SMTP for password-reset delivery (leave PE_SMTP_HOST empty for dev).
PE_SMTP_HOST=
PE_SMTP_PORT=587
PE_SMTP_USERNAME=
PE_SMTP_PASSWORD=
PE_SMTP_FROM=no-reply@pecompass.local
PE_SMTP_STARTTLS=true
PE_SMTP_USE_SSL=false
# Push: FCM legacy server key (empty = stub mode) + admin key for /notifications/send.
PE_FCM_SERVER_KEY=
PE_PUSH_ADMIN_KEY=
# Social login: comma-separated OAuth client IDs accepted as the token audience.
# Google: typically your iOS + Android client IDs. Apple: your app/service IDs.
# Leave empty to disable that provider (its /auth/oauth/* endpoint returns 400).
PE_GOOGLE_CLIENT_IDS=
PE_APPLE_CLIENT_IDS=
# PE admin panel (/pe/admin) — comma-separated allowlisted emails whose owners
# log in with their normal PE account password. PE_ADMIN_SECRET_KEY signs the
# admin session cookie; CHANGE it in production.
PE_ADMIN_EMAILS=admin@pecompass.local
PE_ADMIN_EMAIL=admin@pecompass.local
PE_ADMIN_SECRET_KEY=dev-only-change-me

# --- Admin panel (/admin) ---
# Comma-separated emails allowed to log into the admin UI.
ADMIN_EMAILS=admin@clinicalcompass.local
# Bootstrap admin account created/updated by `make seed_admin`.
ADMIN_EMAIL=admin@clinicalcompass.local
ADMIN_PASSWORD=change-me-please
# Secret used to sign admin session cookies. Change in production.
ADMIN_SECRET_KEY=dev-only-change-me

# --- Social login (Google / Apple OAuth) ---
# Comma-separated OAuth client IDs accepted as the token audience. For Google
# these are typically your iOS and Android client IDs. Leave unset to disable
# that provider (its /auth/oauth/* endpoint then returns 400).
GOOGLE_CLIENT_IDS=
# Apple app/service IDs (the "aud" of the identity token), comma-separated.
APPLE_CLIENT_IDS=

# --- Email / SMTP (password-reset OTP delivery) ---
# Leave SMTP_HOST unset for local dev: the OTP is logged and returned in the
# /auth/forgot-password response instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@clinicalcompass.local
# Use STARTTLS (port 587). Set SMTP_USE_SSL=true instead for implicit TLS (465).
SMTP_STARTTLS=true
SMTP_USE_SSL=false
