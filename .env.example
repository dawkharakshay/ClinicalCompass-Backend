# Copy to .env and adjust. docker compose reads this file automatically.

# --- Postgres (used by the db service) ---
POSTGRES_USER=clinicalcompass
POSTGRES_PASSWORD=clinicalcompass
POSTGRES_DB=clinicalcompass

# --- API ---
# Inside compose the DB host is the service name "db".
DATABASE_URL=postgresql+psycopg://clinicalcompass:clinicalcompass@db:5432/clinicalcompass

# Port nginx is published on (http://localhost:${NGINX_PORT})
NGINX_PORT=8080

# --- Admin panel (/admin) ---
# Comma-separated emails allowed to log into the admin UI.
ADMIN_EMAILS=admin@clinicalcompass.local
# Bootstrap admin account created/updated by `make seed_admin`.
ADMIN_EMAIL=admin@clinicalcompass.local
ADMIN_PASSWORD=change-me-please
# Secret used to sign admin session cookies. Change in production.
ADMIN_SECRET_KEY=dev-only-change-me

# --- Social login (Google / Apple OAuth) ---
# Comma-separated OAuth client IDs accepted as the token audience. For Google
# these are typically your iOS and Android client IDs. Leave unset to disable
# that provider (its /auth/oauth/* endpoint then returns 400).
GOOGLE_CLIENT_IDS=
# Apple app/service IDs (the "aud" of the identity token), comma-separated.
APPLE_CLIENT_IDS=

# --- Email / SMTP (password-reset OTP delivery) ---
# Leave SMTP_HOST unset for local dev: the OTP is logged and returned in the
# /auth/forgot-password response instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@clinicalcompass.local
# Use STARTTLS (port 587). Set SMTP_USE_SSL=true instead for implicit TLS (465).
SMTP_STARTTLS=true
SMTP_USE_SSL=false
