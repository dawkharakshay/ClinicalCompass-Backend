{
  "title": "Epidural Steroid Injection Clinical Compass",
  "form": {
    "version": 1,
    "layout": "wizard",
    "submitLabel": "Assess",
    "logicKey": "epiduralsteroid",
    "hiddenDefaults": {},
    "steps": [
      {
        "id": "patient-info",
        "shortLabel": "Patient Info",
        "title": "Patient Information",
        "fields": [
          {
            "id": "age",
            "name": "age",
            "label": "Age (years)",
            "type": "number",
            "required": false,
            "defaultValue": "",
            "keyboardType": "decimal"
          },
          {
            "id": "pain-score",
            "name": "painScore",
            "label": "Pain Score (0-10)",
            "type": "number",
            "required": true,
            "defaultValue": "",
            "min": 0,
            "max": 10,
            "keyboardType": "decimal"
          },
          {
            "id": "spine-region",
            "name": "spineRegion",
            "label": "Spine Region",
            "type": "buttongroup",
            "required": true,
            "defaultValue": "",
            "options": [
              { "label": "Lumbar", "value": "lumbar" },
              { "label": "Cervical", "value": "cervical" },
              { "label": "Thoracic", "value": "thoracic" }
            ]
          },
          {
            "id": "active-infection",
            "name": "activeInfection",
            "label": "Active local or systemic infection",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "coagulopathy",
            "name": "coagulopathy",
            "label": "Coagulopathy / anticoagulation (not bridged)",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "allergy",
            "name": "allergy",
            "label": "Allergy to steroids or contrast",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "prior-injection-count",
            "name": "priorInjectionCount",
            "label": "Prior ESI Count (this region)",
            "type": "number",
            "required": false,
            "defaultValue": "",
            "keyboardType": "decimal"
          },
          {
            "id": "prior-injection-response",
            "name": "priorInjectionResponse",
            "label": "Prior ESI Response",
            "type": "buttongroup",
            "required": false,
            "defaultValue": "",
            "options": [
              { "label": "None", "value": "none" },
              { "label": "Partial", "value": "partial" },
              { "label": "Good", "value": "good" }
            ]
          }
        ]
      },
      {
        "id": "clinical-assessment",
        "shortLabel": "Clinical Assessment",
        "title": "Clinical Assessment",
        "fields": [
          {
            "id": "symptom-duration-weeks",
            "name": "symptomDurationWeeks",
            "label": "Symptom Duration (weeks)",
            "type": "number",
            "required": false,
            "defaultValue": "",
            "keyboardType": "decimal"
          },
          {
            "id": "conservative-therapy-weeks",
            "name": "conservativeTherapyWeeks",
            "label": "Conservative Therapy Duration (weeks)",
            "type": "number",
            "required": true,
            "defaultValue": "",
            "keyboardType": "decimal"
          },
          {
            "id": "symptoms",
            "name": "symptoms",
            "label": "Symptoms",
            "type": "multiselect",
            "required": false,
            "defaultValue": [],
            "options": [
              { "label": "Radicular pain (dermatomal distribution)", "value": "radicular-pain" },
              { "label": "Axial spine pain", "value": "axial-pain" },
              { "label": "Neurogenic claudication (lumbar stenosis)", "value": "neurogenic-claudication" },
              { "label": "Paresthesia / numbness", "value": "paresthesia" },
              { "label": "Motor weakness", "value": "motor-weakness" }
            ]
          },
          {
            "id": "conservative-therapies",
            "name": "conservativeTherapies",
            "label": "Conservative Therapies Tried",
            "type": "multiselect",
            "required": false,
            "defaultValue": [],
            "options": [
              { "label": "Physical therapy (≥4 weeks)", "value": "pt" },
              { "label": "NSAIDs / analgesics (≥2 weeks)", "value": "nsaids" },
              { "label": "Activity modification", "value": "activity-mod" },
              { "label": "Oral corticosteroids", "value": "oral-steroids" },
              { "label": "Neuropathic agents (gabapentin, pregabalin)", "value": "neuropathic-agents" }
            ]
          }
        ]
      },
      {
        "id": "imaging-approach",
        "shortLabel": "Imaging & Approach",
        "title": "Imaging & Approach",
        "fields": [
          {
            "id": "approach-type",
            "name": "approachType",
            "label": "Injection Approach",
            "type": "buttongroup",
            "required": false,
            "defaultValue": "",
            "options": [
              { "label": "Interlaminar", "value": "interlaminar" },
              { "label": "Transforaminal", "value": "transforaminal" },
              { "label": "Caudal", "value": "caudal" }
            ]
          },
          {
            "id": "imaging-findings",
            "name": "imagingFindings",
            "label": "Imaging Findings (MRI or CT)",
            "type": "multiselect",
            "required": false,
            "defaultValue": [],
            "options": [
              { "label": "Disc herniation with nerve root compression", "value": "disc-herniation" },
              { "label": "Foraminal stenosis", "value": "foraminal-stenosis" },
              { "label": "Central canal stenosis", "value": "central-stenosis" },
              { "label": "Epidural fibrosis (post-surgical)", "value": "epidural-fibrosis" },
              { "label": "Spondylolisthesis", "value": "spondylolisthesis" },
              { "label": "Facet hypertrophy contributing to stenosis", "value": "facet-hypertrophy" }
            ]
          }
        ]
      }
    ]
  }
}
