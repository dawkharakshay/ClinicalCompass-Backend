{
  "title": "Radiation Oncology Clinical Compass",
  "form": {
    "version": 1,
    "layout": "wizard",
    "submitLabel": "Get Recommendations",
    "logicKey": "radonc",
    "hiddenDefaults": {
      "alk": false,
      "priorProstatectomy": false,
      "hccPriorTACE": false
    },
    "steps": [
      {
        "id": "disease-site",
        "shortLabel": "Disease Site",
        "title": "Select Disease Site",
        "fields": [
          {
            "id": "disease-category",
            "name": "diseaseCategory",
            "label": "Disease Site",
            "type": "buttongroup",
            "required": true,
            "defaultValue": "",
            "options": [
              { "label": "CNS Tumors", "value": "cns" },
              { "label": "Head & Neck", "value": "head_neck" },
              { "label": "NSCLC", "value": "nsclc" },
              { "label": "SCLC", "value": "sclc" },
              { "label": "Prostate", "value": "prostate" },
              { "label": "Esophageal / GEJ", "value": "esophageal" },
              { "label": "Gastric", "value": "gastric" },
              { "label": "Rectal", "value": "rectal" },
              { "label": "Lymphoma", "value": "lymphoma" },
              { "label": "Hepatocellular Carcinoma", "value": "hcc" },
              { "label": "Breast", "value": "breast" },
              { "label": "Skin (BCC / cSCC)", "value": "skin" },
              { "label": "Palliative / Oligometastatic", "value": "palliative" }
            ]
          }
        ]
      },
      {
        "id": "clinical-details",
        "shortLabel": "Clinical Details",
        "title": "Clinical Details",
        "fields": [
          {
            "id": "cns-histology",
            "name": "cnsHistology",
            "label": "CNS Histology",
            "type": "select",
            "defaultValue": "",
            "visibleWhen": { "field": "diseaseCategory", "op": "eq", "value": "cns" },
            "options": [
              { "label": "Select histology", "value": "" },
              { "label": "Glioblastoma (GBM)", "value": "GBM" },
              { "label": "Low-Grade Glioma (IDH-mutant)", "value": "LGG" },
              { "label": "Meningioma", "value": "Meningioma" },
              { "label": "Brain Metastases", "value": "Brain_Mets" },
              { "label": "Primary CNS Lymphoma", "value": "PCNSL" },
              { "label": "Ependymoma", "value": "Ependymoma" },
              { "label": "Medulloblastoma", "value": "Medulloblastoma" }
            ]
          },
          {
            "id": "kps-score",
            "name": "kpsScore",
            "label": "Karnofsky Performance Status (KPS)",
            "type": "number",
            "defaultValue": 0,
            "min": 0,
            "max": 100,
            "keyboardType": "decimal",
            "visibleWhen": { "field": "diseaseCategory", "op": "eq", "value": "cns" }
          },
          {
            "id": "mgmt-methylated",
            "name": "mgmtMethylated",
            "label": "MGMT promoter methylated",
            "type": "checkbox",
            "defaultValue": false,
            "visibleWhen": { "all": [
              { "field": "diseaseCategory", "op": "eq", "value": "cns" },
              { "field": "cnsHistology", "op": "eq", "value": "GBM" }
            ] }
          },
          {
            "id": "idh1-mutated",
            "name": "idh1Mutated",
            "label": "IDH1 mutation present",
            "type": "checkbox",
            "defaultValue": false,
            "visibleWhen": { "all": [
              { "field": "diseaseCategory", "op": "eq", "value": "cns" },
              { "field": "cnsHistology", "op": "eq", "value": "GBM" }
            ] }
          },
          {
            "id": "brain-mets-count",
            "name": "brainMetsCount",
            "label": "Number of Brain Mets",
            "type": "number",
            "defaultValue": 0,
            "min": 0,
            "keyboardType": "decimal",
