            "defaultValue": "",
            "visibleWhen": { "field": "diseaseCategory", "op": "eq", "value": "head_neck" },
            "options": [
              { "label": "Select site", "value": "" },
              { "label": "Oropharynx", "value": "Oropharynx" },
              { "label": "Larynx", "value": "Larynx" },
              { "label": "Hypopharynx", "value": "Hypopharynx" },
              { "label": "Oral Cavity", "value": "Oral_Cavity" },
              { "label": "Nasopharynx", "value": "Nasopharynx" },
              { "label": "Salivary Gland", "value": "Salivary" },
              { "label": "Thyroid", "value": "Thyroid" },
              { "label": "Unknown Primary", "value": "Unknown_Primary" }
            ]
          },
          {
            "id": "hpv-status",
            "name": "hpvStatus",
            "label": "HPV/p16 Status",
            "type": "buttongroup",
            "defaultValue": "Unknown",
            "visibleWhen": { "field": "diseaseCategory", "op": "eq", "value": "head_neck" },
            "options": [
              { "label": "Positive", "value": "Positive" },
              { "label": "Negative", "value": "Negative" },
              { "label": "Unknown", "value": "Unknown" }
            ]
          },
          {
            "id": "hn-t",
            "name": "hnT",
            "label": "T Stage",
            "type": "select",
            "defaultValue": "",
            "visibleWhen": { "field": "diseaseCategory", "op": "eq", "value": "head_neck" },
            "options": [
              { "label": "T?", "value": "" },
              { "label": "T1", "value": "T1" },
              { "label": "T2", "value": "T2" },
              { "label": "T3", "value": "T3" },
              { "label": "T4a", "value": "T4a" },
              { "label": "T4b", "value": "T4b" }
            ]
          },
          {
            "id": "hn-n",
            "name": "hnN",
            "label": "N Stage",
            "type": "select",
            "defaultValue": "",
            "visibleWhen": { "field": "diseaseCategory", "op": "eq", "value": "head_neck" },
            "options": [
              { "label": "N?", "value": "" },
              { "label": "N0", "value": "N0" },
              { "label": "N1", "value": "N1" },
              { "label": "N2a", "value": "N2a" },
              { "label": "N2b", "value": "N2b" },
              { "label": "N2c", "value": "N2c" },
              { "label": "N3", "value": "N3" }
            ]
          },
          {
            "id": "hn-m",
            "name": "hnM",
            "label": "M Stage",
            "type": "select",
            "defaultValue": "",
            "visibleWhen": { "field": "diseaseCategory", "op": "eq", "value": "head_neck" },
            "options": [
              { "label": "M?", "value": "" },
              { "label": "M0", "value": "M0" },
              { "label": "M1", "value": "M1" }
            ]
          },
          {
