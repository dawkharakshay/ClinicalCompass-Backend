{
  "title": "Rotator Cuff Repair Clinical Compass",
  "form": {
    "version": 1,
    "layout": "wizard",
    "submitLabel": "Assess",
    "logicKey": "rotatorcuff",
    "hiddenDefaults": {
      "symptomDurationMonths": ""
    },
    "steps": [
      {
        "id": "patient-info",
        "shortLabel": "Patient Info",
        "title": "Patient Information",
        "fields": [
          {
            "id": "age",
            "name": "age",
            "label": "Age (years)",
            "type": "text",
            "required": false,
            "defaultValue": "",
            "keyboardType": "decimal"
          },
          {
            "id": "pain-score",
            "name": "painScore",
            "label": "Pain Score (0-10)",
            "type": "text",
            "required": true,
            "defaultValue": "",
            "keyboardType": "decimal"
          },
          {
            "id": "affected-side",
            "name": "affectedSide",
            "label": "Affected Side",
            "type": "buttongroup",
            "required": true,
            "defaultValue": "",
            "options": [
              { "label": "right", "value": "right" },
              { "label": "left", "value": "left" }
            ]
          },
          {
            "id": "acute-tear",
            "name": "acuteTear",
            "label": "Acute traumatic tear (onset within 6 weeks)",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "dominant-arm",
            "name": "dominantArm",
            "label": "Dominant arm affected",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "high-demand-activity",
            "name": "highDemandActivity",
            "label": "High-demand overhead activity (athlete, laborer)",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "active-infection",
            "name": "activeInfection",
            "label": "Active shoulder infection",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "severe-glenohumeral-arthritis",
            "name": "severeGlenohumeralArthritis",
            "label": "Severe glenohumeral arthritis",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          }
        ]
      },
      {
        "id": "clinical-assessment",
        "shortLabel": "Clinical Assessment",
        "title": "Clinical Assessment",
        "fields": [
          {
            "id": "conservative-therapy-months",
            "name": "conservativeTherapyMonths",
            "label": "Conservative Therapy Duration (months)",
            "type": "text",
            "required": true,
            "defaultValue": "",
            "keyboardType": "decimal"
          },
          {
            "id": "symptoms",
            "name": "symptoms",
            "label": "Symptoms",
            "type": "multiselect",
            "required": false,
            "defaultValue": [],
            "options": [
              { "label": "Pain with overhead activities", "value": "pain-overhead" },
              { "label": "Night pain / sleep disturbance", "value": "pain-night" },
              { "label": "Weakness with external rotation or abduction", "value": "weakness" },
              { "label": "Limited range of motion", "value": "limited-rom" },
              { "label": "Shoulder instability / apprehension", "value": "instability" },
              { "label": "Catching or clicking sensation", "value": "catching" }
            ]
          },
          {
            "id": "conservative-therapies",
            "name": "conservativeTherapies",
            "label": "Conservative Therapies Tried",
            "type": "multiselect",
            "required": false,
            "defaultValue": [],
            "options": [
              { "label": "Physical therapy (≥6 weeks)", "value": "pt" },
              { "label": "NSAIDs / analgesics (≥4 weeks)", "value": "nsaids" },
              { "label": "Subacromial corticosteroid injection", "value": "corticosteroid" },
              { "label": "Activity modification", "value": "activity-mod" }
            ]
          }
        ]
      },
      {
        "id": "imaging-tear",
        "shortLabel": "Imaging & Tear Characteristics",
        "title": "Imaging & Tear Characteristics",
        "fields": [
          {
            "id": "tear-size",
            "name": "tearSize",
            "label": "Tear Size (MRI or Ultrasound)",
            "type": "buttongroup",
            "required": false,
            "defaultValue": "",
            "options": [
              { "label": "Small (<1cm)", "value": "small" },
              { "label": "Medium (1-3cm)", "value": "medium" },
              { "label": "Large (3-5cm)", "value": "large" },
              { "label": "Massive (>5cm)", "value": "massive" }
            ]
          },
          {
            "id": "tear-characteristics",
            "name": "tearCharacteristics",
            "label": "Tear Characteristics",
            "type": "multiselect",
            "required": false,
            "defaultValue": [],
            "options": [
              { "label": "Full-thickness rotator cuff tear", "value": "full-thickness" },
              { "label": "Partial-thickness tear (>50% thickness)", "value": "partial-thickness" },
              { "label": "Significant tendon retraction", "value": "retraction" },
              { "label": "Muscle atrophy (fatty infiltration Goutallier ≥2)", "value": "muscle-atrophy" },
              { "label": "Biceps tendon pathology (SLAP or biceps tear)", "value": "biceps-pathology" },
              { "label": "Acromioclavicular joint pathology", "value": "acromioclavicular" },
              { "label": "Subacromial impingement / bursitis", "value": "subacromial-impingement" }
            ]
          }
        ]
      }
    ]
  }
}
