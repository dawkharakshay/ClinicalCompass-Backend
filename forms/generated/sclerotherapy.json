{
  "title": "Sclerotherapy Clinical Compass",
  "form": {
    "version": 1,
    "layout": "wizard",
    "submitLabel": "Run Assessment",
    "logicKey": "sclerotherapy",
    "hiddenDefaults": {},
    "steps": [
      {
        "id": "patient-vein-info",
        "shortLabel": "Patient & Vein Info",
        "title": "Patient & Vein Info",
        "fields": [
          {
            "id": "age",
            "name": "age",
            "label": "Patient Age",
            "type": "text",
            "required": false,
            "defaultValue": ""
          },
          {
            "id": "symptom-duration-months",
            "name": "symptomDurationMonths",
            "label": "Symptom Duration (months)",
            "type": "text",
            "required": false,
            "defaultValue": ""
          },
          {
            "id": "ceap-class",
            "name": "ceapClass",
            "label": "CEAP Clinical Classification *",
            "type": "select",
            "required": true,
            "defaultValue": "",
            "options": [
              { "label": "C0 — No visible or palpable signs", "value": "C0" },
              { "label": "C1 — Telangiectasias or reticular veins", "value": "C1" },
              { "label": "C2 — Varicose veins", "value": "C2" },
              { "label": "C3 — Edema", "value": "C3" },
              { "label": "C4 — Skin changes", "value": "C4" },
              { "label": "C5 — Healed venous ulcer", "value": "C5" },
              { "label": "C6 — Active venous ulcer", "value": "C6" }
            ]
          },
          {
            "id": "vessel-type",
            "name": "vesselType",
            "label": "Vessel Type to be Treated *",
            "type": "select",
            "required": true,
            "defaultValue": "",
            "options": [
              { "label": "Telangiectasias (spider veins, <1 mm)", "value": "telangiectasia" },
              { "label": "Reticular veins (1–3 mm)", "value": "reticular" },
              { "label": "Varicose veins (>3 mm)", "value": "varicose" },
              { "label": "Residual varicosities after prior ablation", "value": "residual" }
            ]
          },
          {
            "id": "vessel-diameter",
            "name": "vesselDiameter",
            "label": "Vessel Diameter (mm)",
            "type": "text",
            "required": false,
            "defaultValue": ""
          },
          {
            "id": "prior-ablation",
            "name": "priorAblation",
            "label": "Prior endovenous ablation performed (residual varicosities)",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "duplex-confirmed",
            "name": "duplexConfirmed",
            "label": "Duplex ultrasound performed",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "truncal-reflux",
            "name": "truncalReflux",
            "label": "Duplex confirms truncal (GSV/SSV) reflux present",
            "type": "checkbox",
            "required": false,
            "defaultValue": false,
            "visibleWhen": { "field": "duplexConfirmed", "op": "truthy" }
          },
          {
            "id": "foam-requested",
            "name": "foamRequested",
            "label": "Foam sclerotherapy planned",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          }
        ]
      },
      {
        "id": "symptoms-conservative-tx",
        "shortLabel": "Symptoms & Conservative Tx",
        "title": "Symptoms & Conservative Tx",
        "fields": [
          {
            "id": "symptoms",
            "name": "symptoms",
            "label": "Presenting Symptoms * (select all that apply)",
            "type": "multiselect",
            "required": true,
            "defaultValue": [],
            "options": [
              { "label": "Pain or aching in the leg", "value": "pain" },
              { "label": "Heaviness or fatigue", "value": "heaviness" },
              { "label": "Leg swelling", "value": "swelling" },
              { "label": "Itching or burning over veins", "value": "itching" },
              { "label": "Cosmetic concern (spider veins)", "value": "cosmetic" },
              { "label": "Skin changes (pigmentation, eczema)", "value": "skin-changes" },
              { "label": "Bleeding from varicosity", "value": "bleeding" },
              { "label": "Superficial thrombophlebitis", "value": "thrombophlebitis" }
            ]
          },
          {
            "id": "compression-compliance",
            "name": "compressionCompliance",
            "label": "Patient compliant with graduated compression stockings",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "compression-weeks",
            "name": "compressionWeeks",
            "label": "Duration of compression stocking use (weeks)",
            "type": "text",
            "required": false,
            "defaultValue": ""
          }
        ]
      },
      {
        "id": "contraindications",
        "shortLabel": "Contraindications",
        "title": "Contraindications",
        "fields": [
          {
            "id": "pregnancy",
            "name": "pregnancy",
            "label": "Pregnancy",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "breastfeeding",
            "name": "breastfeeding",
            "label": "Breastfeeding",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "active-infection",
            "name": "activeInfection",
            "label": "Active infection at injection site",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "allergy-to-sclerosant",
            "name": "allergyToSclerosant",
            "label": "Known allergy to sclerosant agent",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "severe-peripheral-arterial-disease",
            "name": "severePeripheralArterialDisease",
            "label": "Severe peripheral arterial disease (ABI <0.5)",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "immobility",
            "name": "immobility",
            "label": "Non-ambulatory / immobile patient",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "known-dvt",
            "name": "knownDVT",
            "label": "Prior deep vein thrombosis (DVT)",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "patent-foramen-ovale",
            "name": "patentForamenOvale",
            "label": "Known patent foramen ovale (PFO)",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "migraine-with-aura",
            "name": "migraineWithAura",
            "label": "Migraine with aura",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          }
        ]
      }
    ]
  }
}
