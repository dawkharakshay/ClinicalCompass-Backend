{
  "title": "Pelvic Venous Disease Clinical Compass",
  "form": {
    "version": 1,
    "layout": "wizard",
    "submitLabel": "Save Assessment",
    "logicKey": "womenshealth",
    "hiddenDefaults": {},
    "steps": [
      {
        "id": "demographics",
        "shortLabel": "Demographics",
        "title": "Demographics",
        "fields": [
          {
            "id": "demographics-info",
            "type": "alert",
            "severity": "info",
            "text": "Please provide basic patient demographics. Patient name and ID are not required."
          },
          {
            "id": "age",
            "name": "patientAge",
            "label": "Age (years)",
            "type": "number",
            "required": true,
            "defaultValue": "",
            "min": 18,
            "max": 120,
            "unit": "years",
            "keyboardType": "decimal"
          },
          {
            "id": "bmi",
            "name": "patientBMI",
            "label": "BMI (optional)",
            "type": "number",
            "required": false,
            "defaultValue": "",
            "min": 10,
            "max": 60,
            "keyboardType": "decimal"
          }
        ]
      },
      {
        "id": "symptoms",
        "shortLabel": "Symptoms",
        "title": "Symptoms",
        "fields": [
          {
            "id": "chronic-pelvic-pain",
            "name": "chronicPelvicPain",
            "label": "Chronic Pelvic Pain",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "pain-duration",
            "name": "painDuration",
            "label": "Pain Duration",
            "type": "text",
            "required": false,
            "defaultValue": "",
            "visibleWhen": { "field": "chronicPelvicPain", "op": "truthy" }
          },
          {
            "id": "pain-location",
            "name": "painLocation",
            "label": "Pain Location",
            "type": "radio",
            "required": false,
            "defaultValue": "",
            "options": [
              { "label": "Left", "value": "left" },
              { "label": "Right", "value": "right" },
              { "label": "Bilateral", "value": "bilateral" }
            ],
            "visibleWhen": { "field": "chronicPelvicPain", "op": "truthy" }
          },
          {
            "id": "exacerbated-by-standing",
            "name": "exacerbatedByStanding",
            "label": "Exacerbated by Standing",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "postcoital-pain",
            "name": "postcoitalPain",
            "label": "Postcoital Pain",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "premenstrual-worsening",
            "name": "premenstrualWorsening",
            "label": "Premenstrual Worsening",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "vulvar-varicosities",
            "name": "vulvarVaricosities",
            "label": "Vulvar Varicosities",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "gravidity",
            "name": "gravidity",
            "label": "Gravidity",
            "type": "text",
            "required": false,
            "defaultValue": ""
          },
          {
            "id": "parity",
            "name": "parity",
            "label": "Parity",
            "type": "text",
            "required": false,
            "defaultValue": ""
          }
        ]
      },
      {
        "id": "hemodynamics",
        "shortLabel": "Hemodynamics",
        "title": "Hemodynamics",
        "fields": [
          {
            "id": "lov-diameter",
            "name": "lovDiameter",
            "label": "Left Ovarian Vein Diameter (mm)",
            "type": "number",
            "required": false,
            "defaultValue": "",
            "unit": "mm",
            "keyboardType": "decimal"
          },
          {
            "id": "rov-diameter",
            "name": "rovDiameter",
            "label": "Right Ovarian Vein Diameter (mm)",
            "type": "number",
            "required": false,
            "defaultValue": "",
            "unit": "mm",
            "keyboardType": "decimal"
          },
          {
            "id": "lov-reflux-duration",
            "name": "lovRefluxDuration",
            "label": "Left Ovarian Vein Reflux Duration (sec)",
            "type": "number",
            "required": false,
            "defaultValue": "",
            "unit": "sec",
            "keyboardType": "decimal"
          },
          {
            "id": "rov-reflux-duration",
            "name": "rovRefluxDuration",
            "label": "Right Ovarian Vein Reflux Duration (sec)",
            "type": "number",
            "required": false,
            "defaultValue": "",
            "unit": "sec",
            "keyboardType": "decimal"
          },
          {
            "id": "cross-pelvic-flow",
            "name": "crossPelvicFlow",
            "label": "Cross-Pelvic Flow",
            "type": "radio",
            "required": false,
            "defaultValue": "",
            "options": [
              { "label": "Absent", "value": "absent" },
              { "label": "Present", "value": "present" }
            ]
          },
          {
            "id": "nutcracker-angle",
            "name": "nutcrackerAngle",
            "label": "Nutcracker Angle (degrees)",
            "type": "number",
            "required": false,
            "defaultValue": "",
            "unit": "degrees",
            "keyboardType": "decimal"
          }
        ]
      },
      {
        "id": "anatomy",
        "shortLabel": "Anatomy",
        "title": "Anatomy",
        "fields": [
          {
            "id": "pelvic-varicosities",
            "name": "pelvicVaricosities",
            "label": "Pelvic Varicosities",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "uterine-vein-dilation",
            "name": "uterineVeinDilation",
            "label": "Uterine Vein Dilation",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          },
          {
            "id": "dilated-arcuate-veins",
            "name": "dilatedArcuateVeins",
            "label": "Dilated Arcuate Veins",
            "type": "radio",
            "required": false,
            "defaultValue": "",
            "options": [
              { "label": "None", "value": "none" },
              { "label": "Mild", "value": "mild" },
              { "label": "Pronounced", "value": "pronounced" }
            ]
          },
          {
            "id": "may-thurner",
            "name": "mayThurner",
            "label": "May-Thurner Syndrome",
            "type": "checkbox",
            "required": false,
            "defaultValue": false
          }
        ]
      },
      {
        "id": "ceap",
        "shortLabel": "CEAP",
        "title": "CEAP Classification (for V3 — pelvic-origin lower extremity)",
        "fields": [
          {
            "id": "ceap-info",
            "type": "alert",
            "severity": "info",
            "text": "Complete only for patients with V3 disease (pelvic varices extending to the lower extremities). The SVP instrument is complementary to CEAP for pelvic-origin lower-extremity signs/symptoms; both are reported side by side."
          },
          {
            "id": "ceap-clinical-class",
            "name": "ceapClinicalClass",
            "label": "C — Clinical Class",
            "type": "select",
            "required": false,
            "defaultValue": "",
            "options": [
              { "label": "C0 — No visible/palpable signs", "value": "0" },
              { "label": "C1 — Telangiectasias / reticular veins", "value": "1" },
              { "label": "C2 — Varicose veins (≥3mm)", "value": "2" },
              { "label": "C3 — Edema without skin changes", "value": "3" },
              { "label": "C4 — Skin changes (pigmentation, eczema, LDS)", "value": "4" },
              { "label": "C5 — Healed venous ulcer", "value": "5" },
              { "label": "C6 — Active venous ulcer", "value": "6" }
            ]
          },
          {
            "id": "ceap-etiology",
            "name": "ceapEtiology",
            "label": "E — Etiology",
            "type": "select",
            "required": false,
            "defaultValue": "",
            "options": [
              { "label": "Ec — Congenital", "value": "Ec" },
              { "label": "Ep — Primary (undetermined cause)", "value": "Ep" },
              { "label": "Es — Secondary (post-thrombotic/post-traumatic)", "value": "Es" },
              { "label": "En — No identifiable cause", "value": "En" }
            ]
          },
          {
            "id": "ceap-anatomy",
            "name": "ceapAnatomy",
            "label": "A — Anatomy",
            "type": "select",
            "required": false,
            "defaultValue": "",
            "options": [
              { "label": "As — Superficial veins", "value": "As" },
              { "label": "Ap — Perforator veins", "value": "Ap" },
              { "label": "Ad — Deep veins", "value": "Ad" },
              { "label": "An — No venous location identified", "value": "An" }
            ]
          },
          {
            "id": "ceap-pathophysiology",
            "name": "ceapPathophysiology",
            "label": "P — Pathophysiology",
            "type": "select",
            "required": false,
            "defaultValue": "",
            "options": [
              { "label": "Pr — Reflux", "value": "Pr" },
              { "label": "Po — Obstruction", "value": "Po" },
              { "label": "Pr,o — Reflux and obstruction", "value": "Pr,o" },
              { "label": "Pn — No venous pathophysiology identifiable", "value": "Pn" }
            ]
          }
        ]
      }
    ]
  }
}
